[Unit]
Description=Trivilín - bot de práctica de guitarra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/guitarra-bot
ExecStart=%h/guitarra-bot/.venv/bin/python %h/guitarra-bot/main.py
Restart=always
RestartSec=5
Nice=10
CPUWeight=20
MemoryMax=300M
NoNewPrivileges=true

[Install]
WantedBy=default.target
